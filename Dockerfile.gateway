# ==========================================
# Stage 1: Build virtual environment and install dependencies via uv
# ==========================================
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=python3.14

WORKDIR /app

# Install project dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev

# Copy application source and install package
COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


# ==========================================
# Stage 2: Production Runtime for mcp-gateway
# ==========================================
FROM python:3.14-slim AS gateway-runtime

WORKDIR /app

# Install runtime curl healthcheck dependency & create secure non-root user
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 10001 gateway && \
    useradd -u 10001 -g gateway -m -s /bin/bash gateway

# Copy built virtual environment and source code from builder
COPY --from=builder --chown=gateway:gateway /app/.venv /app/.venv
COPY --from=builder --chown=gateway:gateway /app/src /app/src
COPY --from=builder --chown=gateway:gateway /app/pyproject.toml /app/pyproject.toml

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER gateway
EXPOSE 2026

CMD ["mcp-gateway"]
